---
import DocRows from "../../components/DocRows.astro";
import DocSection from "../../components/DocSection.astro";
import DocTable from "../../components/DocTable.astro";
import Intro from "../../components/Intro.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";

const PARTS = [
  ["Archive browsing", "DANDI, EMBER and OpenNeuro search and dataset pages", "Search or browse an archive, open a dataset, read its metadata and pick a file from its tree."],
  ["File viewing", "NWB file view, plus EDF, video, SLEAP and the OpenNeuro file viewers", "Stream a file from its URL, list what’s inside, open objects in views that share time, and hand off to Python."],
  ["Setup and help", "Settings, the NWB viewer guide, Neurosift Chat", "Add API keys for embargoed data, learn the viewer, or ask in plain language. Chat is a separate site."],
];

const ARCHIVES = [
  ["DANDI search", "Finds Dandisets on api.dandiarchive.org.", "Three modes: Basic text, Semantic (CatalystNeuro index) and Neurodata types, where every chosen type must be in the same file. Recent Dandisets. API key for embargoed results.", "Result cards: title, ID, created, modified, contact, version, file count, size, “N matching” files, embargo status.", "All three search modes; recents; the matching-file count; embargo handling."],
  ["Dandiset page", "Describes one Dandiset and lists its files.", "Version (published versions and draft). Show NWB files only.", "Title, description, contributors, ID, version, dates, status, size, file count, license and citation; folder and file tree with sizes; View on DANDI.", "Version choice; NWB-only filter; every metadata field; the tree."],
  ["EMBER search and Dandiset", "The same as DANDI, on api-dandi.emberarchive.org.", "As DANDI, with an EMBER API key.", "As DANDI.", "Parity with DANDI."],
  ["OpenNeuro search and dataset", "Finds and opens OpenNeuro datasets through its GraphQL API.", "Search text. Recent datasets.", "Dataset metadata and file tree; files open in the OpenNeuro file viewers below.", "Every file type it can open."],
];

const TABS = [
  ["Widgets", "The main workspace.", "Left: the overview panel (Dandiset title and description, session and subject metadata, file creation, keywords, notes, source script, NWB version, Using LINDI). Right: Main, a tree of top-level groups and neurodata objects, and one tab per opened object.", "Opening objects in tabs; checking several objects to open them together in one combined view; the collapsible overview panel."],
  ["Videos", "Only when the file has video.", "Every video in the file, side by side, on one shared time slider.", "Copying a link with the arrangement and time."],
  ["Icephys", "Only when the file has intracellular ephys.", "Intracellular ephys recordings, not yet reviewed in depth.", "Everything it shows today."],
  ["Timeseries alignment", "Checks timing across the file.", "The start and end of every timeseries, interval table and events object on one axis; click to open one.", "The whole-file overview of timing."],
  ["Python usage", "Writes a script for the whole file.", "PyNWB and LINDI code with every object and its type, shape and description as comments; Copy Script.", "The generated script."],
  ["Schema", "Shows the NWB specifications in the file.", "The NWB specifications embedded in the file.", "All of it."],
  ["HDF5", "Shows the raw file.", "Groups, datasets, attributes, shapes and dtypes.", "All of it."],
