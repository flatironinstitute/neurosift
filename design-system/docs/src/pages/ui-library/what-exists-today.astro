const LEAVE = [
  ["View on DANDI", "Full metadata, downloads and account actions live on DANDI", "Keep the link; say what DANDI adds."],
  ["Load in Python", "Analysis happens in their own environment", "Intended. Make the code copyable everywhere."],
  ["Neurosift v1 (the “1” button)", "Some views or links may only exist in v1", "Confirm what v1 still offers; label the button."],
  ["Neurosift Chat", "It’s a separate site, chat.neurosift.app", "Link from the home page as today, clearly marked experimental."],
  ["GitHub, to report problems", "No in-app feedback", "Keep “Report this” in error alerts."],
];

const PROBLEMS = [
  ["Search query lost on Back", "DANDI search", "Upstream #321"],
  ["File name not shown in the file view", "NWB file view", "Upstream #369"],
  ["Embargoed files and bad URLs show Loading… forever", "NWB file view", "Upstream #525, #352; fixed by the redesign"],
  ["Folders open only from the small ► arrow", "Dandiset file tree", "Walkthrough"],
  ["PSTH opens empty until units are ticked", "PSTH", "Walkthrough"],
  ["DANDI result list takes about 17 s to appear", "DANDI search", "Walkthrough"],
  ["EMBER key helper names DANDI and api.dandiarchive.org", "Settings", "Code; fixed by the redesign"],
  ["Invalid typed values snap back with no message", "Time window fields", "Code"],
];

const CONFIRM = [
  ["Should the Widgets tab be called Views, and multi-object tabs a combined view?", "File view naming"],
  ["What does Neurosift v1 still do that v2 doesn’t?", "App bar, “Open in v1”"],
  ["Should shared links include the time window, not only the tab?", "Share, Time controls"],
  ["Are channel and unit ranges meant to stay zero-based?", "Channel window"],
  ["Why does the Plotly toggle exist: speed, export or interaction?", "Raster and timeseries views"],
  ["Does the two-photon view load in a normal browser? It never finished in headless Chromium for Dandiset 000728.", "Imaging views"],
  ["What should the Icephys tab show at a glance?", "Icephys"],
];
---

<DocsLayout title="What exists today" description="Every part of Neurosift: what it does, takes in and shows, and what a redesign must keep.">
  <Intro
    lead="A functional reference for every part of Neurosift: what it does, what it takes in, what it shows, and the features any redesign must keep. It records behavior, not today’s look. The design system replaces the visuals; the data, the views and the way they stay in sync stay exactly as they are."
    status="Compiled November 5, 2026 · UI library · Sources: the Neurosift repository (routes, 23 view plugins, 8 file viewers), the 2024 JOSS paper, its 351 GitHub issues, and a Playwright walkthrough of neurosift.app"
    rules={[
      { title: "Keep every view", text: "Each plugin, control, option and download listed here stays. Only how it’s presented changes." },
      { title: "Keep the sync", text: "Views of one file share a time window and cursor, and a link restores the tab. That is the product." },
      { title: "Ask before guessing", text: "Anything under “To confirm” needs an answer from Jeremy or Ben before it’s drawn." },
    ]}
  />

  <DocSection title="How to use this page" lead="Read it before redesigning any screen. Keep every input, option, view and download listed for that area, then change only how it’s presented, using the system’s components. The UI library pages that follow redesign each area in turn." />

  <DocSection title="Three parts of Neurosift" lead="Everything belongs to one part, and each part already shares most of its flow.">
    <DocTable caption="Three parts of Neurosift" columns={["Part", "Pages", "Shared flow"]}><DocRows rows={PARTS} /></DocTable>
  </DocSection>

  <DocSection title="Archive browsing">
    <DocTable caption="Archive browsing" columns={["Page", "What it does", "Input and options", "What it shows", "Must keep"]}><DocRows rows={ARCHIVES} /></DocTable>
  </DocSection>

  <DocSection title="NWB file view" lead="Route /nwb?url=… with optional dandisetId, dandisetVersion and tab. The file is read in the browser with HTTP range requests, or through a LINDI index when one exists, so nothing is downloaded first.">
    <DocTable caption="NWB file view tabs" columns={["Tab", "What it does", "Shows", "Must keep"]}><DocRows rows={TABS} /></DocTable>
    <DocTable caption="Across the file view" columns={["Behavior", "Detail"]}><DocRows rows={ACROSS} /></DocTable>
  </DocSection>

  <DocSection title="View plugins" lead="Neurosift picks the views that can open an object from its neurodata type and contents. They appear in this order. Launchable means the view can also start from a table row.">
    <DocTable caption="View plugins" columns={["View", "Opens for", "What it shows", "Controls today"]}><DocRows rows={PLUGINS} /></DocTable>
  </DocSection>

  <DocSection title="Other file viewers">
    <DocTable caption="Other file viewers" columns={["Viewer", "Route", "Opens, and must keep"]}><DocRows rows={VIEWERS} /></DocTable>
  </DocSection>

  <DocSection title="Links" lead="Researchers save Neurosift links, so these forms open the same thing forever. A redesign that renames a route, tab or plugin maps the old form; docs/saved-links.md lists every form with an example.">
    <DocTable caption="Saved link forms" columns={["Kind", "Form", "Opens"]}><DocRows rows={LINKS} /></DocTable>
  </DocSection>

  <DocSection title="Shared building blocks" lead="Parts that repeat. Each has a component in this system, and a UI library page that uses it.">
    <DocTable caption="Shared building blocks" columns={["Building block", "Used by", "Component", "UI library page"]}><DocRows rows={BLOCKS} /></DocTable>
  </DocSection>

  <DocSection title="Where people leave Neurosift" lead="Each is a chance to keep people in the tool, without changing any data.">
    <DocTable caption="Where people leave Neurosift" columns={["Step today", "Why they leave", "Opportunity"]}><DocRows rows={LEAVE} /></DocTable>
  </DocSection>

  <DocSection title="Known problems" lead="From the walkthrough and the issue tracker. Each is fixed by presentation, not by changing data.">
    <DocTable caption="Known problems" columns={["Problem", "Where", "Source"]}><DocRows rows={PROBLEMS} /></DocTable>
  </DocSection>

  <DocSection title="To confirm" lead="Questions for Jeremy and Ben. The design waits on these answers; the science doesn’t change.">
    <DocTable caption="To confirm" columns={["Question", "Where it matters"]}><DocRows rows={CONFIRM} /></DocTable>
  </DocSection>
</DocsLayout>
