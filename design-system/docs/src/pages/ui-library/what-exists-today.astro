const VIEWERS = [
  ["OpenNeuro file viewers", "/openneuro-dataset/:id", "NIfTI (axial, coronal, sagittal, 3D render and all four), JSON, TSV, text, EDF, SNIRF and WAV files from a dataset’s tree. Keep every format and the NIfTI view choices."],
  ["EDF page", "/edf", "EDF recordings as timeseries, with channel selection, separation and the OpenNeuro file’s place. The play control in the code was never shown."],
  ["Video page", "/video", "A video file by URL."],
  ["SLEAP page", "/slp", "SLEAP .slp pose files as a tree."],
  ["Settings", "/settings", "DANDI, DANDI sandbox and EMBER API keys, saved in this browser’s localStorage; a reload applies them."],
  ["NWB viewer guide", "/guide", "How to use the viewer."],
