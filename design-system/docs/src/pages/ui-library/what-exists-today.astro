];

const BLOCKS = [
  ["Time window and step buttons", "Every time view", "Time window, Time overview", "Time series views"],
  ["Channel or unit window", "Timeseries, raster", "Channel window", "Time series views; Spike views"],
  ["Control panel with sections", "PSTH, event-related signal, spectrogram", "Accordion item, Select, Slider, Text input", "Spike views; Spectrogram"],
  ["Selection lists", "PSTH units and ROIs, align to", "Checkbox with counts, in compact rows", "Spike views"],
  ["File and object trees", "Dandiset files, NWB objects, HDF5", "Tree", "Dataset page; Neurodata object tree; HDF5 and schema"],
