---
import DocRows from "../../components/DocRows.astro";
import DocSection from "../../components/DocSection.astro";
import DocTable from "../../components/DocTable.astro";
import Intro from "../../components/Intro.astro";
import Screen from "../../components/Screen.astro";
import LiveScreen from "../../components/LiveScreen.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { withBase } from "../../navigation";

const DIFFERS = [
  ["Words", "The guide as written", "The same words, in the same order", "Same"],
  ["Page", "Material UI container, centered, with its own margins", "Page: the title at type/h2 and a 720px column at the page margin, like Settings", "Changed"],
  ["Sections", "Headings on the page background", "Overview, Using Neurosift and Getting Help each in a Section, named by its heading", "Changed"],
  ["Topics", "Five headings one step down from the sections", "The same five as h3 in type/label, each with its steps", "Changed"],
  ["Text", "Gray body text at 16px", "type/body in text/default", "Changed"],
  ["Links", "Dark blue, underlined only on hover", "text/link, always underlined, text/link-hover on hover", "Changed"],
  ["Commands", "Gray boxes of plain code", "Code block, Shell, with a Copy button", "Changed"],
  ["URL format", "Inline code", "Inline code", "Same"],
];

const SPECS = [
  ["Page", "Page: 24px margins, layout/page-margin · 720px column, layout/text-max · 24px between sections · type/h2 title"],
  ["Sections", "Section: surface/panel · 1px border/strong · radius/sm · 24px padding · type/h4 title · 16px between blocks"],
  ["Topics", "h3 in type/label · 8px to its text and steps · 16px more before the next topic"],
  ["Text and steps", "type/body, text/default · numbered and bulleted lists indented 24px, 8px between items"],
  ["Links", "Plain links in text/link, underlined, text/link-hover on hover · the global focus ring"],
  ["Code", "Code block, Shell, 8px below its step · Inline code for the URL format"],
];
---

<DocsLayout title="Guide" description="The NWB viewer guide, linked from Home’s footer, rebuilt from Page and Section.">
  <Intro
    lead="The guide explains how to explore DANDI, EMBER and OpenNeuro and how to open remote and local NWB files. Home’s footer links to it as NWB viewer guide. The words stay exactly as they are; only the page around them changes."
    status="Updated November 10, 2026 · UI library · Captured at 1440 × 900 · Built from Page, Section, type styles, links, Code block and Inline code"
    rules={[
      { title: "Same words", text: "The guide reads word for word as it does today; the rebuild changes only how it looks." },
      { title: "Commands copy cleanly", text: "Each command sits in a Code block with a Copy button, so nobody retypes it." },
      { title: "Links look like links", text: "Every link is underlined in text/link, not only on hover." },
    ]}
  />

  <DocSection title="Existing guide" lead="neurosift.app/guide today: the top of the page, then the remote and local file steps.">
    <Screen file="guide-today" alt="Today’s guide: a large Neurosift Guide title, an Overview heading with gray text, and numbered steps for exploring DANDI and EMBER." caption="Material UI page with gray body text, links underlined only on hover, and headings straight on the page background." />
    <Screen file="guide-today-local" alt="Today’s guide further down: the remote and local file steps, with the two commands in gray boxes." caption="The commands sit in plain gray boxes with nothing to copy them." />
  </DocSection>

  <DocSection title="Proposed guide" lead="The redesign’s guide at the same two places. The page below the top bar is what the app shows now.">
    <Screen file="guide-proposed" alt="The rebuilt guide: a Neurosift Guide title, then bordered sections for Overview and Using Neurosift, with underlined blue links and numbered steps." caption="The title at the page margin, each part of the guide in a Section, and links underlined in text/link." />
    <Screen file="guide-proposed-local" alt="The rebuilt guide further down: the remote file steps with the URL format as inline code, and the local file steps with each command in a Shell code block with a Copy button." caption="Each command in a Shell Code block with Copy; the URL format stays inline code." />
    <p class="doc-note">Built from <a href={withBase("/components/pages/")}>Page and Section</a>, the <a href={withBase("/foundations/typography/")}>type styles</a> and <a href={withBase("/components/code/")}>Code block and Inline code</a>.</p>
  </DocSection>

  <DocSection title="What differs" lead="Same works the same way. Changed looks or reads differently but does the same thing.">
    <DocTable caption="What differs" columns={["Area", "Existing", "Proposed", "Status"]}>
      <DocRows rows={DIFFERS} />
    </DocTable>
  </DocSection>

  <DocSection title="Specs" lead="Values for developers. Every value is a token.">
    <DocTable caption="Guide specs" columns={["Part", "Spec"]}>
      <DocRows rows={SPECS} />
    </DocTable>
  </DocSection>

  <DocSection title="Try it" lead="Copy a command, or follow a link.">
    <LiveScreen path="guide" title="NWB viewer guide" size="default" />
  </DocSection>
</DocsLayout>
