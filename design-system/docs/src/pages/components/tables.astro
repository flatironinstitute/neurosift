---
import ObjectTreeDemo from "../../components/ObjectTreeDemo";
import Existing from "../../components/Existing.astro";
import CodeSample from "../../components/CodeSample.astro";
import DoDont from "../../components/DoDont.astro";
import DocSection from "../../components/DocSection.astro";
import DocTable from "../../components/DocTable.astro";
import Intro from "../../components/Intro.astro";
import { FileTreeDemo, UnitsTableDemo } from "../../components/TableDemo";
import DocsLayout from "../../layouts/DocsLayout.astro";

const CELL_TYPES = [
  ["Text", "Plex Sans, type/body-sm", "Left", "Cedars-Sinai Medical Center"],
  ["Number", "Plex Mono, type/code-sm", "Right, with thousands commas", "1,652"],
  ["Code", "Plex Mono, type/code-sm", "Left", "ElectricalSeries · /units · 000673"],
  ["Missing", "text/muted, read as “No value”", "Same as the column", "—"],
];

const KEYS = [
  ["Tab", "Moves between sort buttons and row checkboxes", "Moves into the tree, then out of it"],
  ["Up and Down arrows", "—", "Move between rows"],
  ["Right arrow", "—", "Opens a folder, or moves into it"],
  ["Left arrow", "—", "Closes a folder, or moves to its parent"],
  ["Home, End", "—", "First or last row"],
  ["Enter", "Sorts from a header", "Opens the file, or opens and closes a folder"],
  ["Space", "Toggles the row’s checkbox", "Selects the row"],
];

const WRITING = [
  ["Name, Size", "NAME, SIZE", "Sentence case, no caps"],
  ["Spikes", "# spikes", "A word, not a symbol"],
  ["Select units in the table to plot them.", "Select one or more units to plot", "Says where to act"],
  ["—", "NaN, undefined, empty cells", "One consistent sign for missing"],
];

const SPECS = [
  ["Header", "32px · SemiBold 12 · text/table-head · 1px border/strong below · stays in view while scrolling"],
  ["Row", "32px layout/row-default or 24px layout/row-compact · 1px border/subtle below"],
  ["Cell padding", "8px · space/2"],
  ["Hover", "surface/row-hover"],
  ["Selected", "surface/row-selected · text/on-inverse; the checked box inverts too"],
  ["Sort", "Carbon arrow--up or arrow--down, on the sorted column and on hover"],
  ["Tree indent", "16px per level"],
  ["Tree icons", "16px · chevron, folder, folder--open, data--structured, document"],
];

const code = `import { DataTable, Tree } from "@ui";

<DataTable
  caption="Units"
  columns={[
    { key: "id", label: "Unit ID", type: "code", value: (u) => u.id },
    {
      key: "spikes",
      label: "Spikes",
      type: "number",
      value: (u) => u.spikes,
      sortable: true,
    },
  ]}
  rows={units}
  rowKey={(u) => String(u.id)}
  sort={sort}
  onSort={setSort}
  selected={selected}
  onSelectedChange={setSelected}
/>

<Tree
  label="Files"
  nodes={files}
  expanded={open}
  onExpandedChange={setOpen}
  selected={file}
  onSelect={setFile}
  onOpen={openFile}
/>`;
---

<DocsLayout title="Tables" description="DataTable and Tree: where people read the data itself.">
  <Intro
    lead="Tables show NWB dynamic tables, such as units, trials and electrodes, and the selection lists in plot panels. Trees show the folders and files of a Dandiset and the groups inside an HDF5 file. Both are where people read the data itself, so they stay quiet: black rules, plain rows, numbers in the code face."
    status="Updated November 10, 2026 · Components · Every example on this page is the component the app imports from @ui"
    rules={[
      { title: "Rules, not fills", text: "Headers sit on a 1px black rule and rows on light rules. No filled header bar, no zebra stripes." },
      { title: "Data in the code face", text: "Numbers, IDs, paths and neurodata types use Plex Mono. Numbers align right so digits line up." },
      { title: "The whole row is the target", text: "Click anywhere on a tree row to open it, and anywhere on a table row to select it." },
    ]}
  />

  <Existing page="tables" />

  <DocSection title="Data table" lead="The units table of Dandiset 000673: spike counts from the file, and firing rate as spikes over the 1,375.28 s session. Sort from a header; select rows with their checkboxes or a click anywhere on the row.">
    <UnitsTableDemo client:visible />
    <p class="doc-note">The Notes column has no values, so each cell shows —, never NaN, undefined or a blank. Selected rows invert: navy with white text, the same signal as everywhere else. Units go in the header, so cells hold only numbers.</p>
  </DocSection>

  <DocSection title="File tree" lead="Folders and files of a Dandiset, and the groups and datasets of an HDF5 file. File names and sizes are illustrative.">
    <FileTreeDemo client:visible />
    <p class="doc-note">Anywhere on a folder row opens or closes it; today only the ► arrow does, which the walkthrough found people missed. Clicking an NWB file opens it, and folders say how many files they hold.</p>
  </DocSection>

  <DocSection title="Object tree" lead="The Main tab of a file: every object with its type, description and views. The name opens the object; the checkboxes add an object or one of its views to a combined view. Check two or more to see the selection bar.">
    <ObjectTreeDemo client:visible />
    <ul class="rule-list">
      <li><strong>Object row.</strong> Chevron, checkbox, the type icon, a name that opens the object, the neurodata type in link blue when it has a view, and a one-line description cut with an ellipsis, the full text on hover; its views follow as chips. Each level indents 16px.</li>
      <li><strong>Selection bar.</strong> Up to two names; past two, two names and a count that opens the full list. At 768px and below, only the count. Clear unchecks everything; View together opens the selection in one tab.</li>
      <li><strong>Selection list.</strong> Everything checked, in the order checked; each × unchecks one.</li>
    </ul>
  </DocSection>

  <DocSection title="Density" lead="Default rows are 32px for reading. Compact rows are 24px, for long selection lists in plot panels, such as units and channels.">
    <UnitsTableDemo client:visible density="compact" />
  </DocSection>

  <DocSection title="Cell types">
    <DocTable caption="Cell types" columns={["Type", "Face", "Align", "Example"]}>
      {CELL_TYPES.map(([type, face, align, example]) => <tr><th scope="row">{type}</th><td>{face}</td><td>{align}</td><td>{example}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Sorting, selection and long values">
    <ul class="rule-list">
      <li><strong>Sort from the header.</strong> Click a header to sort ascending, again for descending. The arrow and aria-sort show the direction. One column at a time.</li>
      <li><strong>Select with checkboxes.</strong> When rows can be picked for a plot, a checkbox column comes first and the toolbar says how many are selected.</li>
      <li><strong>Open one row’s details.</strong> When a row opens its details beside the table, as in Schema, there are no checkboxes: the first cell is the row’s button, the whole row takes the click, and the open row inverts. Pass <code>active</code> and <code>onActivate</code>.</li>
      <li><strong>Empty folders don’t open.</strong> A folder whose children are known to be none, such as an empty HDF5 group, has no chevron and says Empty.</li>
      <li><strong>Long values wrap or open.</strong> Descriptions wrap to three lines with a Disclosure; IDs and paths truncate in the middle with the full value in a tooltip.</li>
    </ul>
  </DocSection>

  <DocSection title="Keyboard" lead="Tables are real tables, reached with Tab through their sort buttons and checkboxes. Trees follow the WAI-ARIA tree view pattern, one stop in the tab order.">
    <DocTable caption="Keyboard" columns={["Key", "Table", "Tree"]}>
      {KEYS.map(([key, table, tree]) => <tr><th scope="row">{key}</th><td>{table}</td><td>{tree}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Writing" lead="Rewrites of strings in the app today.">
    <DocTable caption="Writing tables" columns={["Use", "Instead of", "Why"]}>
      {WRITING.map(([use, instead, why]) => <tr><th scope="row">{use}</th><td>{instead}</td><td>{why}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Accessibility">
    <ul class="rule-list">
      <li><strong>Real tables.</strong> A table with a caption and column headers; trees use role=tree with aria-expanded, aria-level, and their position in each level.</li>
      <li><strong>Sort is announced.</strong> aria-sort on the header, so “Spikes, sorted descending” is read.</li>
      <li><strong>Contrast.</strong> Headers are 7.0:1; muted dashes 5.3:1; inverted rows 10.98:1.</li>
      <li><strong>Targets.</strong> Rows are at least 24px tall and the whole row is clickable.</li>
    </ul>
  </DocSection>

  <DocSection title="Usage">
    <DoDont
      dos={["Right-align numbers in Plex Mono.", "Put units in the header.", "Show — for missing values.", "Keep the header visible while scrolling."]}
      donts={["Don’t fill the header with color.", "Don’t stripe rows.", "Don’t cut off values without a way to read them.", "Don’t make only the arrow open a folder."]}
    />
  </DocSection>

  <DocSection title="Specs" lead="Values for developers. Every value is a token.">
    <DocTable caption="Table and tree specs" columns={["Property", "Value"]}>
      {SPECS.map(([property, value]) => <tr><th scope="row">{property}</th><td>{value}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="In code" lead="Import from @ui. Both are controlled: the view owns sorting, selection and which folders are open, so it can load a folder's contents when it opens.">
    <CodeSample label="React" code={code} />
  </DocSection>
</DocsLayout>
