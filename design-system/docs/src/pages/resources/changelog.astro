const FIGMA = [
  ["November 6, 2026", "The UI library pages from the dataset page to HDF5 and schema, the Resources pages, and the Neurodata object tree components on Tables."],
  ["November 5, 2026", "Foundations, tokens, usage guidelines, 15 component frames and their pages, Checkbox, Home options B and C (C, search first, chosen), What exists today, and Archive search with neurodata types ordered by the dandi-index counts of 213 types."],
];

const REPO = "https://github.com/jguerrero-prog/neurosift/pull/";
const date = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<DocsLayout title="Changelog" description="What changed in the design system, newest first.">
  <Intro
    lead="What changed in the design system, newest first: the pull requests that built it in code, in jguerrero-prog/neurosift (the fork where the redesign was built, so the numbers are that repository’s, not this one’s), then the work in Figma that came before. Anything marked “to confirm” on a page stays a proposal until Jeremy Magland and Ben Dichter agree."
    status="Updated November 10, 2026 · Resources · Code dates are when a pull request merged, in UTC"
    rules={[
      { title: "Newest first", text: "Each day lists its changes with the latest at the top." },
      { title: "By page", text: "Entries name the page or component that changed, so they can be found in the menu." },
      { title: "Proposals stay marked", text: "A change marked “to confirm” is still a question, not a decision." },
    ]}
  />

  {
    MERGED.map(([day, prs]) => (
      <DocSection title={`In code, ${date(day)}`}>
        <ul class="rule-list">
          {prs.map(([number, title]) => (
            <li>
              <a href={`${REPO}${number.slice(1)}`}>jguerrero-prog/neurosift{number}</a> {title}
            </li>
          ))}
        </ul>
      </DocSection>
    ))
  }

  <DocSection title="In Figma" lead="The design work these pages came from, in the Figma file.">
    <DocTable caption="Figma changes" columns={["Date", "Change"]}>
      <DocRows rows={FIGMA} />
    </DocTable>
  </DocSection>
</DocsLayout>
