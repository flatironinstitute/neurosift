---
interface Props {
  caption: string;
  columns: string[];
}

const { caption, columns } = Astro.props;
---

<div class="doc-table" role="region" aria-label={caption} tabindex="0">
  <table>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>{columns.map((column) => <th scope="col">{column}</th>)}</tr>
    </thead>
    <tbody>
      <slot />
    </tbody>
  </table>
</div>
