{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "IBM Plex Sans JP",
          "IBM Plex Sans",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 400,
        "fontSize": {
          "value": 56,
          "unit": "px"
        },
        "lineHeight": 1.05,
        "letterSpacing": {
          "value": -1.12,
          "unit": "px"
        }
      },
      "$description": "Home page title, once per page",
      "$extensions": {
        "com.figma": {
          "style": "type/display"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": {
          "value": 36,
          "unit": "px"
        },
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": -0.36,
          "unit": "px"
        }
      },
      "$description": "Page titles: dandiset and file names",
      "$extensions": {
        "com.figma": {
          "style": "type/h1"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
